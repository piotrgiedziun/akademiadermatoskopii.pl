---
/**
 * ScheduleList — list of course dates. Used on /kursy/ (all editions) and on
 * each course page (that course's editions). Each entry can link to its course
 * page and carry a sold-out marker; past dates are flagged as completed
 * automatically.
 *
 * Bookable editions get a direct "Zapisz się" link that deep-links into
 * /zapisy/ with both the course and the term preselected, so a visitor who has
 * already picked a date never has to find it again in a dropdown.
 */
import type { ScheduleEntry } from '@/lib/courses';

export interface Props {
  entries: ScheduleEntry[];
  city?: string;
  /**
   * Course slug for the register links. Needed on /kursy/[slug]/, which strips
   * `slug` from its entries so the dates don't link back to the page you're on.
   */
  courseSlug?: string;
}

const { entries, city = 'Wrocław', courseSlug } = Astro.props;

// An edition is "completed" once its end date has fully passed. Entries carry
// real Dates (derived from course frontmatter), so this is an exact comparison.
// Evaluated at build time, so it stays correct on each rebuild.
const now = new Date();
const isCompleted = (entry: ScheduleEntry): boolean => {
  const endOfDay = new Date(entry.end);
  endOfDay.setHours(23, 59, 59, 999);
  return endOfDay.getTime() < now.getTime();
};

/**
 * Deep link into the registration form. The date is the same UTC calendar date
 * key used by /terminy.json and the D1 rows, so the form matches it exactly.
 */
const registerHref = (entry: ScheduleEntry): string | null => {
  const slug = entry.slug ?? courseSlug;
  if (!slug) return null;
  const termin = entry.start.toISOString().slice(0, 10);
  return `/zapisy/?kurs=${encodeURIComponent(slug)}&termin=${termin}`;
};
---

<ol class="schedule" role="list">
  {entries.map((e) => {
    const completed = isCompleted(e);
    return (
      <li class:list={['schedule__item', completed ? 'schedule__item--completed' : e.soldOut && 'schedule__item--sold-out']}>
        <span class="schedule__city">{city},</span>
        <time class="schedule__date">{e.date}</time>
        {e.slug ? (
          <a class="schedule__title" href={`/kursy/${e.slug}/`}>{e.title}</a>
        ) : (
          <span class="schedule__title">{e.title}</span>
        )}
        {completed ? (
          <span class="schedule__badge schedule__badge--done">zakończony</span>
        ) : e.soldOut ? (
          <span class="schedule__badge">wyprzedany</span>
        ) : e.status === 'cancelled' ? (
          <span class="schedule__badge">odwołany</span>
        ) : registerHref(e) ? (
          <a class="schedule__register" href={registerHref(e)}>
            Zapisz się<span aria-hidden="true"> →</span>
            <span class="visually-hidden"> na termin {e.date}, {e.title}</span>
          </a>
        ) : null}
      </li>
    );
  })}
</ol>

<style>
  .schedule {
    list-style: none;
    padding: 0;
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-line);
    overflow: hidden;
    background: var(--color-bg);
  }

  .schedule__item {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    padding: var(--space-sm) var(--space-md);
    font-size: var(--fs-sm);
    line-height: 1.5;
    counter-increment: schedule;
  }

  .schedule__item + .schedule__item {
    border-top: 1px solid var(--color-line-soft);
  }

  .schedule__item--sold-out {
    background: var(--color-bg-soft);
  }

  .schedule__item--sold-out .schedule__title {
    color: var(--color-ink-soft);
  }

  .schedule__item--completed {
    background: var(--color-bg-soft);
  }

  .schedule__item--completed .schedule__city,
  .schedule__item--completed .schedule__date,
  .schedule__item--completed .schedule__title {
    color: var(--color-ink-soft);
  }

  .schedule__badge--done {
    background: var(--color-bg-soft);
    color: var(--color-ink-soft);
  }

  .schedule__city {
    color: var(--color-ink-muted);
  }

  .schedule__date {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .schedule__title {
    color: var(--color-ink);
    text-decoration: none;
  }

  a.schedule__title:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a.schedule__title:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-sm);
  }

  .schedule__register {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary-50);
    border: 1px solid var(--color-primary-500);
    color: var(--color-primary-700);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-xs) var(--ease-out);
  }

  .schedule__register:hover {
    background: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: #fff;
  }

  .schedule__register:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .schedule__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (max-width: 40em) {
    .schedule__item {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'city date'
        'title title'
        'badge badge';
    }
    .schedule__city { grid-area: city; }
    .schedule__date { grid-area: date; justify-self: start; }
    .schedule__title { grid-area: title; }
    .schedule__badge,
    .schedule__register { grid-area: badge; justify-self: start; }
  }
</style>
