# Cloudflare Pages — cache and security headers
#
# Edge caching: Pages serves HTML as `max-age=0, must-revalidate`, and
# Cloudflare honours that by not caching it at all — every page view reached the
# origin (cf-cache-status: DYNAMIC). `Cloudflare-CDN-Cache-Control` outranks
# `Cache-Control` at the edge and is stripped before the response leaves it, so
# the rule below parks pages at the edge for a week while browsers keep
# revalidating on every navigation. Deploys purge the zone (see
# .github/workflows/deploy.yml), so a week-long TTL never means week-old pages —
# if that purge ever stops running, this TTL becomes the staleness window.
#
# HTML carries no ETag or Last-Modified, so a revalidation can never come back
# as a cheap 304: the TTL is the only thing keeping bodies off the origin.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://www.youtube.com; connect-src 'self'; form-action 'self'
  Cloudflare-CDN-Cache-Control: public, max-age=604800, stale-while-revalidate=604800

# CMS admin (Sveltia) needs to reach the GitHub API. Drop the site-wide CSP for
# this path (Cloudflare otherwise *combines* CSP headers into the intersection)
# and apply a scoped policy. Self-hosted bundle keeps script-src on 'self'.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net/fontsource/fonts/; connect-src 'self' blob: data: https://api.github.com https://github.com https://raw.githubusercontent.com https://avatars.githubusercontent.com https://www.githubstatus.com https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net/fontsource/fonts/; worker-src 'self' blob:; frame-src 'self' blob:; media-src blob:; manifest-src blob:; form-action 'self' https://github.com
  X-Robots-Tag: noindex

# Registration form — Turnstile loads a script and an iframe from
# challenges.cloudflare.com. The site-wide CSP above allows neither, and
# Cloudflare *intersects* CSP headers rather than replacing them, so the policy
# must be dropped with `!` first and restated in full (same trick as /admin/*).
/zapisy/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; form-action 'self'

# Registration admin — behind Cloudflare Access. Same CSP as the site, minus
# indexing. The middleware already returns `Cache-Control: no-store`, but
# Cloudflare-CDN-Cache-Control from /* outranks it at the edge, so physicians'
# registration data would be cached and served to whoever asked next. Drop it.
/admin-rejestracje/*
  ! Cloudflare-CDN-Cache-Control
  Cloudflare-CDN-Cache-Control: no-store
  X-Robots-Tag: noindex

# Same reasoning for the Functions: /api/availability reports live seat counts
# and /oauth/* carries one-shot CMS login state. Both already say no-store.
/api/*
  ! Cloudflare-CDN-Cache-Control
  Cloudflare-CDN-Cache-Control: no-store

/oauth/*
  ! Cloudflare-CDN-Cache-Control
  Cloudflare-CDN-Cache-Control: no-store

/fonts/*
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

/_astro/*
  ! Cloudflare-CDN-Cache-Control
  Cache-Control: public, max-age=31536000, immutable
  Cloudflare-CDN-Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=604800
